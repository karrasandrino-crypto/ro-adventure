{% doc %}
  @prompt
    a space to add a form
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-form-space-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    color: #121212;
    background: #f9f6ef;
    border: 1px solid rgba(18, 18, 18, 0.2);
    border-radius: 4px;
    box-sizing: border-box;
  }

  .ai-form-space-{{ ai_gen_id }}__heading {
    margin: 0 0 8px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
  }

  .ai-form-space-{{ ai_gen_id }}__intro {
    margin: 0 0 18px;
    line-height: 1.5;
  }

  .ai-form-space-{{ ai_gen_id }}__content {
    min-height: 80px;
  }

  .ai-form-space-{{ ai_gen_id }}__content:empty::before {
    content: 'Add your form using a Custom liquid block or a form app block in the theme editor.';
    display: block;
    padding: 16px;
    border: 1px dashed rgba(18, 18, 18, 0.45);
    border-radius: 4px;
    color: #333333;
    line-height: 1.5;
  }
{% endstyle %}

<div class="ai-form-space-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-form-space-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.intro != blank %}
    <div class="ai-form-space-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</div>
  {% endif %}
  <div class="ai-form-space-{{ ai_gen_id }}__content">
    {{ block.settings.form_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "Form space",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Become an authorised RŌ dealer"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Share your details and our team will be in touch.</p>"
    },
    {
      "type": "liquid",
      "id": "form_liquid",
      "label": "Form code",
      "info": "Paste trusted form-app embed code or Liquid here. For a form app block, add that block separately in the theme editor."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Form space"
    }
  ],
  "tag": null,
  "class": "form-space-block"
}
{% endschema %}